// MİHSAP platformu — PostgreSQL veri modeli. Kurallar: docs/DATABASE_ARCHITECTURE.md
// Kiracı tablolarında organization_id + RLS (politikalar migration SQL'inde).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Uygulama kısıtlı rolle bağlanır (RLS uygulanır); migration'lar yönetici rolüyle.
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum Role {
  OFFICE_OWNER
  ACCOUNTANT
  STAFF
  AUDITOR
  TAXPAYER_USER
  READ_ONLY
}

enum LedgerType {
  BILANCO
  ISLETME
  SERBEST_MESLEK
}

enum TaxIdType {
  VKN
  TCKN
}

enum RecordStatus {
  ACTIVE
  ARCHIVED
}

enum FiscalPeriodStatus {
  OPEN
  CLOSED
}

// ---- Kimlik (kiracı dışı) ----

model User {
  id                 String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email              String     @unique @db.VarChar(320) // her zaman küçük harf
  fullName           String     @map("full_name") @db.VarChar(200)
  passwordHash       String     @map("password_hash")
  status             UserStatus @default(ACTIVE)
  mustChangePassword Boolean    @default(false) @map("must_change_password")
  isSuperAdmin       Boolean    @default(false) @map("is_super_admin")
  createdAt          DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  sessions    Session[]
  memberships Membership[]

  @@map("users")
}

model Session {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // Token'ın SHA-256 özeti (hex); token'ın kendisi saklanmaz
  tokenHash      String    @unique @map("token_hash") @db.Char(64)
  userId         String    @map("user_id") @db.Uuid
  organizationId String?   @map("organization_id") @db.Uuid
  ipAddress      String?   @map("ip_address") @db.VarChar(64)
  userAgent      String?   @map("user_agent") @db.VarChar(300)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastSeenAt     DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model LoginAttempt {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email     String   @db.VarChar(320)
  ipAddress String?  @map("ip_address") @db.VarChar(64)
  success   Boolean
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([email, createdAt])
  @@index([ipAddress, createdAt])
  @@map("login_attempts")
}

// ---- Kiracı (RLS) ----

model Organization {
  id        String       @id @db.Uuid // uygulama üretir (RLS bağlamı oluşturmadan önce gerekir)
  name      String       @db.VarChar(255)
  taxId     String?      @map("tax_id") @db.VarChar(11)
  status    RecordStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  branches        Branch[]
  memberships     Membership[]
  taxpayers       Taxpayer[]
  taxpayerAssigns TaxpayerAssignment[]
  fiscalPeriods   FiscalPeriod[]
  auditLogs       AuditLog[]
  documents       Document[]
  documentEvents  DocumentStatusEvent[]
  extractions     DocumentExtraction[]
  invoices        Invoice[]
  invoiceLines    InvoiceLine[]
  invoiceTaxes    InvoiceTax[]
  ledgerAccounts  LedgerAccount[]
  roleMappings    AccountRoleMapping[]
  postingRules    PostingRule[]
  journalEntries  JournalEntry[]
  journalLines    JournalEntryLine[]
  corrections     AccountCorrection[]
  bankAccounts    BankAccount[]
  bankStatements  BankStatement[]
  bankTxns        BankTransaction[]
  bankRules       BankRule[]

  @@map("organizations")
}

model Branch {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  name           String       @db.VarChar(200)
  status         RecordStatus @default(ACTIVE)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberships  Membership[]

  @@unique([organizationId, name])
  @@map("branches")
}

model Membership {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  role           Role
  branchId       String?      @map("branch_id") @db.Uuid
  status         RecordStatus @default(ACTIVE)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy      String?      @map("created_by") @db.Uuid

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch       Branch?              @relation(fields: [branchId], references: [id], onDelete: SetNull)
  assignments  TaxpayerAssignment[]

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("memberships")
}

model Taxpayer {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  title          String       @db.VarChar(255)
  taxIdType      TaxIdType    @map("tax_id_type")
  taxId          String       @map("tax_id") @db.VarChar(11)
  taxOffice      String?      @map("tax_office") @db.VarChar(120)
  naceCode       String?      @map("nace_code") @db.VarChar(10)
  activity       String?      @db.VarChar(255)
  ledgerType     LedgerType   @default(BILANCO) @map("ledger_type")
  address        String?      @db.VarChar(500)
  status         RecordStatus @default(ACTIVE)
  version        Int          @default(1)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy      String?      @map("created_by") @db.Uuid

  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignments    TaxpayerAssignment[]
  fiscalPeriods  FiscalPeriod[]
  documents      Document[]
  invoices       Invoice[]
  accounts       LedgerAccount[]
  roleMappings   AccountRoleMapping[]
  postingRules   PostingRule[]
  journal        JournalEntry[]
  corrections    AccountCorrection[]
  bankAccounts   BankAccount[]
  bankStatements BankStatement[]
  bankTxns       BankTransaction[]
  bankRules      BankRule[]

  @@unique([organizationId, taxId])
  @@index([organizationId, status])
  @@map("taxpayers")
}

model TaxpayerAssignment {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  taxpayerId     String   @map("taxpayer_id") @db.Uuid
  membershipId   String   @map("membership_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy      String?  @map("created_by") @db.Uuid

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  taxpayer     Taxpayer     @relation(fields: [taxpayerId], references: [id], onDelete: Cascade)
  membership   Membership   @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@unique([taxpayerId, membershipId])
  @@map("taxpayer_assignments")
}

model FiscalPeriod {
  id             String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String             @map("organization_id") @db.Uuid
  taxpayerId     String             @map("taxpayer_id") @db.Uuid
  name           String             @db.VarChar(50) // ör. "2026"
  startDate      DateTime           @map("start_date") @db.Date
  endDate        DateTime           @map("end_date") @db.Date
  status         FiscalPeriodStatus @default(OPEN)
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy      String?            @map("created_by") @db.Uuid

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  taxpayer     Taxpayer       @relation(fields: [taxpayerId], references: [id], onDelete: Cascade)
  documents    Document[]
  journal      JournalEntry[]

  @@unique([taxpayerId, name])
  @@index([taxpayerId, startDate])
  @@map("fiscal_periods")
}

model AuditLog {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  actorUserId    String?  @map("actor_user_id") @db.Uuid
  action         String   @db.VarChar(80) // ör. "taxpayer.create"
  resourceType   String   @map("resource_type") @db.VarChar(60)
  resourceId     String?  @map("resource_id") @db.VarChar(64)
  taxpayerId     String?  @map("taxpayer_id") @db.Uuid
  // Değişiklik özeti; parola/token/tam kimlik numarası yazılmaz
  details        Json?
  ipAddress      String?  @map("ip_address") @db.VarChar(64)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@map("audit_logs")
}

// =====================================================================
// Faz 2 — Belgeler
// =====================================================================

// Belge durum makinesi (geçişler: src/server/documents/stateMachine.ts)
enum DocumentStatus {
  UPLOADED
  VALIDATING
  QUEUED
  CLASSIFYING
  EXTRACTING
  OCR_PROCESSING
  AI_PROCESSING
  VALIDATION_REQUIRED
  ACCOUNTING_PENDING
  NEEDS_REVIEW
  APPROVED
  EXPORT_PENDING
  EXPORTING
  EXPORTED
  FAILED
  DUPLICATE
  REJECTED
  ARCHIVED
}

// Dosya biçimi: içerik imzasından tespit edilir, uzantıya güvenilmez
enum DocumentFormat {
  XML
  PDF
  IMAGE
  SPREADSHEET
  CSV
  ZIP
  OTHER
}

// İş anlamında belge türü (sınıflandırmadan)
enum DocumentType {
  E_INVOICE
  E_ARCHIVE_INVOICE
  UNKNOWN
}

enum InvoiceDirection {
  PURCHASE
  SALE
}

model Document {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId    String            @map("organization_id") @db.Uuid
  taxpayerId        String            @map("taxpayer_id") @db.Uuid
  fiscalPeriodId    String?           @map("fiscal_period_id") @db.Uuid
  // ZIP'ten çıkarılan belgenin kaynağı
  parentDocumentId  String?           @map("parent_document_id") @db.Uuid
  // Mükerrer yüklemede ilk (asıl) belge
  duplicateOfId     String?           @map("duplicate_of_id") @db.Uuid
  originalName      String            @map("original_name") @db.VarChar(255)
  mimeType          String            @map("mime_type") @db.VarChar(100)
  format            DocumentFormat
  sizeBytes         Int               @map("size_bytes")
  sha256            String            @db.Char(64)
  storageKey        String?           @map("storage_key") @db.VarChar(300)
  status            DocumentStatus    @default(UPLOADED)
  statusReason      String?           @map("status_reason") @db.VarChar(500)
  documentType      DocumentType      @default(UNKNOWN) @map("document_type")
  direction         InvoiceDirection?
  ettn              String?           @db.VarChar(36)
  documentNo        String?           @map("document_no") @db.VarChar(50)
  documentDate      DateTime?         @map("document_date") @db.Date
  counterpartyTaxId String?           @map("counterparty_tax_id") @db.VarChar(11)
  counterpartyName  String?           @map("counterparty_name") @db.VarChar(255)
  payableAmount     Decimal?          @map("payable_amount") @db.Decimal(18, 2)
  currency          String?           @db.Char(3)
  uploadedBy        String?           @map("uploaded_by") @db.Uuid
  version           Int               @default(1)
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  taxpayer     Taxpayer              @relation(fields: [taxpayerId], references: [id], onDelete: Cascade)
  fiscalPeriod FiscalPeriod?         @relation(fields: [fiscalPeriodId], references: [id], onDelete: SetNull)
  parent       Document?             @relation("DocumentChildren", fields: [parentDocumentId], references: [id], onDelete: SetNull)
  children     Document[]            @relation("DocumentChildren")
  duplicateOf  Document?             @relation("DocumentDuplicates", fields: [duplicateOfId], references: [id], onDelete: SetNull)
  duplicates   Document[]            @relation("DocumentDuplicates")
  events       DocumentStatusEvent[]
  extractions  DocumentExtraction[]
  invoice      Invoice?
  journal      JournalEntry[]
  bankMatches  BankTransaction[]

  @@index([taxpayerId, status])
  @@index([taxpayerId, sha256])
  @@index([taxpayerId, ettn])
  @@index([organizationId, createdAt])
  @@map("documents")
}

// Değiştirilemez durum geçmişi: kim (kullanıcı veya worker), ne zaman, neden
model DocumentStatusEvent {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String          @map("organization_id") @db.Uuid
  documentId     String          @map("document_id") @db.Uuid
  fromStatus     DocumentStatus? @map("from_status")
  toStatus       DocumentStatus  @map("to_status")
  reason         String?         @db.VarChar(500)
  actorUserId    String?         @map("actor_user_id") @db.Uuid
  actorWorker    String?         @map("actor_worker") @db.VarChar(80)
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  document     Document     @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId, createdAt])
  @@map("document_status_events")
}

model DocumentExtraction {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  documentId     String   @map("document_id") @db.Uuid
  parser         String   @db.VarChar(40) // ör. "ubl-tr"
  parserVersion  String   @map("parser_version") @db.VarChar(20)
  method         String   @db.VarChar(20) // XML_PARSER | PDF_TEXT | OCR | AI | MANUAL
  // Yapılandırılmış çıktı ve alan bazında { value, source, method, confidence }
  data           Json
  fields         Json
  // { errors: [...], warnings: [...] }
  validation     Json
  confidence     Decimal  @db.Decimal(4, 3)
  isCurrent      Boolean  @default(true) @map("is_current")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  document     Document     @relation(fields: [documentId], references: [id], onDelete: Cascade)
  invoice      Invoice?

  @@index([documentId, isCurrent])
  @@map("document_extractions")
}

model Invoice {
  id                  String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId      String           @map("organization_id") @db.Uuid
  taxpayerId          String           @map("taxpayer_id") @db.Uuid
  documentId          String           @unique @map("document_id") @db.Uuid
  extractionId        String           @unique @map("extraction_id") @db.Uuid
  direction           InvoiceDirection
  profileId           String           @map("profile_id") @db.VarChar(40)
  invoiceTypeCode     String           @map("invoice_type_code") @db.VarChar(40)
  invoiceNo           String           @map("invoice_no") @db.VarChar(50)
  ettn                String           @db.VarChar(36)
  issueDate           DateTime         @map("issue_date") @db.Date
  currency            String           @db.Char(3)
  exchangeRate        Decimal?         @map("exchange_rate") @db.Decimal(18, 6)
  supplierTaxId       String?          @map("supplier_tax_id") @db.VarChar(11)
  supplierName        String?          @map("supplier_name") @db.VarChar(255)
  customerTaxId       String?          @map("customer_tax_id") @db.VarChar(11)
  customerName        String?          @map("customer_name") @db.VarChar(255)
  lineExtensionAmount Decimal          @map("line_extension_amount") @db.Decimal(18, 2)
  allowanceTotal      Decimal          @default(0) @map("allowance_total") @db.Decimal(18, 2)
  taxExclusiveAmount  Decimal          @map("tax_exclusive_amount") @db.Decimal(18, 2)
  taxInclusiveAmount  Decimal          @map("tax_inclusive_amount") @db.Decimal(18, 2)
  withholdingTotal    Decimal          @default(0) @map("withholding_total") @db.Decimal(18, 2)
  payableAmount       Decimal          @map("payable_amount") @db.Decimal(18, 2)
  createdAt           DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  taxpayer     Taxpayer           @relation(fields: [taxpayerId], references: [id], onDelete: Cascade)
  document     Document           @relation(fields: [documentId], references: [id], onDelete: Cascade)
  extraction   DocumentExtraction @relation(fields: [extractionId], references: [id], onDelete: Cascade)
  lines        InvoiceLine[]
  taxes        InvoiceTax[]

  @@index([taxpayerId, issueDate])
  @@map("invoices")
}

model InvoiceLine {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  invoiceId      String   @map("invoice_id") @db.Uuid
  lineNo         Int      @map("line_no")
  name           String   @db.VarChar(500)
  stockCode      String?  @map("stock_code") @db.VarChar(100)
  quantity       Decimal  @db.Decimal(18, 4)
  unitCode       String?  @map("unit_code") @db.VarChar(10)
  unitPrice      Decimal? @map("unit_price") @db.Decimal(21, 8)
  discountAmount Decimal  @default(0) @map("discount_amount") @db.Decimal(18, 2)
  lineAmount     Decimal  @map("line_amount") @db.Decimal(18, 2)
  vatRate        Decimal  @map("vat_rate") @db.Decimal(5, 2)
  vatAmount      Decimal  @default(0) @map("vat_amount") @db.Decimal(18, 2)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoice      Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@unique([invoiceId, lineNo])
  @@map("invoice_lines")
}

model InvoiceTax {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  invoiceId      String   @map("invoice_id") @db.Uuid
  taxTypeCode    String?  @map("tax_type_code") @db.VarChar(10) // 0015 = KDV
  taxName        String   @map("tax_name") @db.VarChar(100)
  rate           Decimal? @db.Decimal(5, 2)
  taxableAmount  Decimal  @map("taxable_amount") @db.Decimal(18, 2)
  taxAmount      Decimal  @map("tax_amount") @db.Decimal(18, 2)
  isWithholding  Boolean  @default(false) @map("is_withholding")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoice      Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_taxes")
}

// =====================================================================
// Arka plan iş kuyruğu: kiracı dışı sistem tablosu; worker her iş için ofis bağlamı açar
// =====================================================================

enum JobStatus {
  PENDING
  RUNNING
  SUCCEEDED
  DEAD
}

model Job {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  type           String    @db.VarChar(60)
  // Aynı işin ikinci kez kuyruğa alınmasını engeller (ör. "document.process:<id>")
  idempotencyKey String    @unique @map("idempotency_key") @db.VarChar(200)
  payload        Json
  status         JobStatus @default(PENDING)
  attempts       Int       @default(0)
  maxAttempts    Int       @default(3) @map("max_attempts")
  runAfter       DateTime  @default(now()) @map("run_after") @db.Timestamptz(6)
  lockedAt       DateTime? @map("locked_at") @db.Timestamptz(6)
  lockedBy       String?   @map("locked_by") @db.VarChar(80)
  lastError      String?   @map("last_error") @db.VarChar(2000)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([status, runAfter])
  @@map("jobs")
}

// =====================================================================
// Faz 3 — Muhasebe motoru
// =====================================================================

/// Mükellefe özel hesap planı. TDHP ana hesapları şablondur; ofis alt hesap açar (ör. 320.01.001).
model LedgerAccount {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  taxpayerId     String   @map("taxpayer_id") @db.Uuid
  code           String   @db.VarChar(30)
  name           String   @db.VarChar(200)
  isPostable     Boolean  @default(true) @map("is_postable")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  taxpayer     Taxpayer             @relation(fields: [taxpayerId], references: [id], onDelete: Cascade)
  roleMappings AccountRoleMapping[]
  postingRules PostingRule[]
  lines        JournalEntryLine[]   @relation("LineAccount")
  bankAccounts BankAccount[]        @relation("BankLedgerAccount")
  bankRules    BankRule[]           @relation("BankRuleAccount")

  @@unique([taxpayerId, code])
  @@map("ledger_accounts")
}

/// Fiş satırı rolleri: kural motoru rolü mükellefin hesabına çözer.
enum AccountRole {
  PURCHASE_DEFAULT // Alış: mal/gider varsayılan hesabı (işletmeye göre değişir, ofis seçer)
  INPUT_VAT // İndirilecek KDV
  SUPPLIER // Satıcılar
  VAT_WITHHOLDING // Alışta sorumlu sıfatıyla ödenecek KDV tevkifatı
  SALES_REVENUE // Yurt içi satışlar
  OUTPUT_VAT // Hesaplanan KDV
  CUSTOMER // Alıcılar
  SALES_RETURN // Satıştan iadeler
}

model AccountRoleMapping {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String      @map("organization_id") @db.Uuid
  taxpayerId     String      @map("taxpayer_id") @db.Uuid
  role           AccountRole
  accountId      String      @map("account_id") @db.Uuid
  updatedAt      DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  taxpayer     Taxpayer      @relation(fields: [taxpayerId], references: [id], onDelete: Cascade)
  account      LedgerAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@unique([taxpayerId, role])
  @@index([accountId])
  @@map("account_role_mappings")
}

/// Mükellefe özel kesin kural: bu karşı taraftan gelen (yöndeki) faturanın ana satırı bu hesaba.
model PostingRule {
  id                String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId    String           @map("organization_id") @db.Uuid
  taxpayerId        String           @map("taxpayer_id") @db.Uuid
  counterpartyTaxId String           @map("counterparty_tax_id") @db.VarChar(11)
  counterpartyName  String?          @map("counterparty_name") @db.VarChar(255)
  direction         InvoiceDirection
  accountId         String           @map("account_id") @db.Uuid
  isActive          Boolean          @default(true) @map("is_active")
  createdBy         String?          @map("created_by") @db.Uuid
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  taxpayer     Taxpayer      @relation(fields: [taxpayerId], references: [id], onDelete: Cascade)
  account      LedgerAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@unique([taxpayerId, counterpartyTaxId, direction])
  @@index([accountId])
  @@map("posting_rules")
}

enum JournalEntryStatus {
  DRAFT // Öneri / düzenleniyor
  POSTED // Kesinleşti (değiştirilemez)
  REVERSED // Ters kayıtla iptal edildi
}

model JournalEntry {
  id                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId    String             @map("organization_id") @db.Uuid
  taxpayerId        String             @map("taxpayer_id") @db.Uuid
  fiscalPeriodId    String             @map("fiscal_period_id") @db.Uuid
  documentId        String?            @map("document_id") @db.Uuid
  reversalOfId      String?            @unique @map("reversal_of_id") @db.Uuid
  // Yevmiye numarası: kesinleşirken dönem içinde sırayla verilir
  entryNo           Int?               @map("entry_no")
  entryDate         DateTime           @map("entry_date") @db.Date
  description       String             @db.VarChar(500)
  status            JournalEntryStatus @default(DRAFT)
  source            String             @db.VarChar(20) // RULE_ENGINE | MANUAL | REVERSAL
  direction         InvoiceDirection?
  counterpartyTaxId String?            @map("counterparty_tax_id") @db.VarChar(11)
  counterpartyName  String?            @map("counterparty_name") @db.VarChar(255)
  // Kesinleşirken veritabanı tetikleyicisi hesaplar
  totalDebit        Decimal            @default(0) @map("total_debit") @db.Decimal(18, 2)
  totalCredit       Decimal            @default(0) @map("total_credit") @db.Decimal(18, 2)
  // Öneri sırasında bulunan uyarı/hatalar: [{ code, message, severity }]
  findings          Json               @default("[]")
  createdBy         String?            @map("created_by") @db.Uuid
  postedBy          String?            @map("posted_by") @db.Uuid
  postedAt          DateTime?          @map("posted_at") @db.Timestamptz(6)
  version           Int                @default(1)
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization    Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  taxpayer        Taxpayer            @relation(fields: [taxpayerId], references: [id], onDelete: Cascade)
  fiscalPeriod    FiscalPeriod        @relation(fields: [fiscalPeriodId], references: [id], onDelete: Restrict)
  document        Document?           @relation(fields: [documentId], references: [id], onDelete: SetNull)
  reversalOf      JournalEntry?       @relation("Reversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversedBy      JournalEntry?       @relation("Reversal")
  lines           JournalEntryLine[]
  corrections     AccountCorrection[]
  bankTransaction BankTransaction?

  @@unique([fiscalPeriodId, entryNo])
  @@index([taxpayerId, status, entryDate])
  @@index([documentId])
  @@index([taxpayerId, counterpartyTaxId])
  @@map("journal_entries")
}

model JournalEntryLine {
  id                String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId    String  @map("organization_id") @db.Uuid
  entryId           String  @map("entry_id") @db.Uuid
  lineNo            Int     @map("line_no")
  // Öneride hesap çözülemediyse boş kalır; boş satırlı fiş kesinleşemez
  accountId         String? @map("account_id") @db.Uuid
  // Satırın fişteki görevi: MAIN (gider/gelir), VAT, COUNTERPARTY, WITHHOLDING, OTHER_TAX
  kind              String  @db.VarChar(20)
  debit             Decimal @default(0) @db.Decimal(18, 2)
  credit            Decimal @default(0) @db.Decimal(18, 2)
  description       String  @db.VarChar(300)
  // Önerinin kaynağı ve gerekçesi (POSTING_RULE, HISTORY, ROLE_MAPPING, UNRESOLVED, USER)
  source            String  @db.VarChar(20)
  reason            String  @db.VarChar(500)
  proposedAccountId String? @map("proposed_account_id") @db.Uuid

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  entry        JournalEntry   @relation(fields: [entryId], references: [id], onDelete: Cascade)
  account      LedgerAccount? @relation("LineAccount", fields: [accountId], references: [id], onDelete: Restrict)

  @@unique([entryId, lineNo])
  @@index([accountId])
  @@map("journal_entry_lines")
}

/// Öğrenme kaydı: kullanıcı önerilen hesabı değiştirdiğinde ne önerildi, ne seçildi.
model AccountCorrection {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId    String            @map("organization_id") @db.Uuid
  taxpayerId        String            @map("taxpayer_id") @db.Uuid
  entryId           String            @map("entry_id") @db.Uuid
  counterpartyTaxId String?           @map("counterparty_tax_id") @db.VarChar(11)
  direction         InvoiceDirection?
  lineKind          String            @map("line_kind") @db.VarChar(20)
  proposedAccountId String?           @map("proposed_account_id") @db.Uuid
  proposedSource    String            @map("proposed_source") @db.VarChar(20)
  chosenAccountId   String            @map("chosen_account_id") @db.Uuid
  ruleCreated       Boolean           @default(false) @map("rule_created")
  createdBy         String?           @map("created_by") @db.Uuid
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  taxpayer     Taxpayer     @relation(fields: [taxpayerId], references: [id], onDelete: Cascade)
  entry        JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@index([taxpayerId, counterpartyTaxId])
  @@map("account_corrections")
}

// =====================================================================
// Faz 4 — Banka ekstresi ve mutabakat
// =====================================================================

/// Mükellefin banka hesabı; hareketleri muhasebede bu defter hesabına (ör. 102.01) işlenir.
model BankAccount {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid
  taxpayerId      String   @map("taxpayer_id") @db.Uuid
  name            String   @db.VarChar(120)
  bankName        String?  @map("bank_name") @db.VarChar(120)
  iban            String?  @db.VarChar(34)
  currency        String   @default("TRY") @db.Char(3)
  ledgerAccountId String   @map("ledger_account_id") @db.Uuid
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization  Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  taxpayer      Taxpayer          @relation(fields: [taxpayerId], references: [id], onDelete: Cascade)
  ledgerAccount LedgerAccount     @relation("BankLedgerAccount", fields: [ledgerAccountId], references: [id], onDelete: Restrict)
  statements    BankStatement[]
  transactions  BankTransaction[]

  @@unique([taxpayerId, name])
  @@index([ledgerAccountId])
  @@map("bank_accounts")
}

enum BalanceCheck {
  OK // Her satırda önceki bakiye + tutar = bakiye
  MISMATCH // En az bir satırda tutmadı
  NO_BALANCE // Ekstrede bakiye sütunu yok
}

model BankStatement {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  taxpayerId     String       @map("taxpayer_id") @db.Uuid
  bankAccountId  String       @map("bank_account_id") @db.Uuid
  fileName       String       @map("file_name") @db.VarChar(255)
  sha256         String       @db.Char(64)
  format         String       @db.VarChar(10) // CSV | XLSX
  periodStart    DateTime     @map("period_start") @db.Date
  periodEnd      DateTime     @map("period_end") @db.Date
  openingBalance Decimal?     @map("opening_balance") @db.Decimal(18, 2)
  closingBalance Decimal?     @map("closing_balance") @db.Decimal(18, 2)
  rowCount       Int          @map("row_count")
  importedCount  Int          @map("imported_count")
  duplicateCount Int          @map("duplicate_count")
  balanceCheck   BalanceCheck @map("balance_check")
  // Kullanılan sütun eşlemesi ve bulgular (bakiye uyuşmazlıkları, süreklilik uyarısı)
  mapping        Json
  findings       Json         @default("[]")
  createdBy      String?      @map("created_by") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  taxpayer     Taxpayer          @relation(fields: [taxpayerId], references: [id], onDelete: Cascade)
  bankAccount  BankAccount       @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  transactions BankTransaction[]

  @@unique([bankAccountId, sha256])
  @@index([bankAccountId, periodEnd])
  @@map("bank_statements")
}

enum BankTransactionStatus {
  UNMATCHED // Bekliyor
  MATCHED // Fişe bağlandı
  IGNORED // Kullanıcı yok saydı (ör. başka yerde işlenen virman)
}

model BankTransaction {
  id                String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId    String                @map("organization_id") @db.Uuid
  taxpayerId        String                @map("taxpayer_id") @db.Uuid
  bankAccountId     String                @map("bank_account_id") @db.Uuid
  statementId       String                @map("statement_id") @db.Uuid
  rowNo             Int                   @map("row_no")
  txDate            DateTime              @map("tx_date") @db.Date
  valueDate         DateTime?             @map("value_date") @db.Date
  description       String                @db.VarChar(500)
  reference         String?               @db.VarChar(100)
  // İşaretli tutar: + hesaba giriş, − hesaptan çıkış
  amount            Decimal               @db.Decimal(18, 2)
  balance           Decimal?              @db.Decimal(18, 2)
  // Mükerrer aktarım engeli: tarih|tutar|açıklama|bakiye|referans|dosya içi sıra
  fingerprint       String                @db.Char(64)
  status            BankTransactionStatus @default(UNMATCHED)
  matchedDocumentId String?               @map("matched_document_id") @db.Uuid
  journalEntryId    String?               @unique @map("journal_entry_id") @db.Uuid
  matchReason       String?               @map("match_reason") @db.VarChar(500)
  matchedBy         String?               @map("matched_by") @db.Uuid
  matchedAt         DateTime?             @map("matched_at") @db.Timestamptz(6)
  createdAt         DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  taxpayer        Taxpayer      @relation(fields: [taxpayerId], references: [id], onDelete: Cascade)
  bankAccount     BankAccount   @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  statement       BankStatement @relation(fields: [statementId], references: [id], onDelete: Cascade)
  matchedDocument Document?     @relation(fields: [matchedDocumentId], references: [id], onDelete: SetNull)
  journalEntry    JournalEntry? @relation(fields: [journalEntryId], references: [id], onDelete: SetNull)

  @@unique([bankAccountId, fingerprint])
  @@index([bankAccountId, status, txDate])
  @@index([statementId])
  @@index([matchedDocumentId])
  @@map("bank_transactions")
}

enum BankRuleDirection {
  IN
  OUT
  ANY
}

/// Açıklama anahtar kelimesi → hesap (ör. "EFT ÜCRETİ" → 780). Kullanıcının sınıflandırmasından öğrenilir.
model BankRule {
  id             String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String            @map("organization_id") @db.Uuid
  taxpayerId     String            @map("taxpayer_id") @db.Uuid
  keyword        String            @db.VarChar(100)
  direction      BankRuleDirection @default(ANY)
  accountId      String            @map("account_id") @db.Uuid
  isActive       Boolean           @default(true) @map("is_active")
  createdBy      String?           @map("created_by") @db.Uuid
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  taxpayer     Taxpayer      @relation(fields: [taxpayerId], references: [id], onDelete: Cascade)
  account      LedgerAccount @relation("BankRuleAccount", fields: [accountId], references: [id], onDelete: Restrict)

  @@unique([taxpayerId, keyword, direction])
  @@index([accountId])
  @@map("bank_rules")
}
