# Uygulama: kısıtlı rol (RLS uygulanır). Gerçek değerleri .env dosyasına yazın; .env commit edilmez.
DATABASE_URL="postgresql://mihsap_app:mihsap_app_dev@localhost:5434/mihsap?schema=public"
# Migration'lar: yönetici rolü (yalnızca prisma migrate / seed kullanır)
DIRECT_DATABASE_URL="postgresql://mihsap_admin:mihsap_admin_dev@localhost:5434/mihsap?schema=public"

# Uygulamanın dış adresi (CSRF kaynak kontrolü ve çerezler için)
APP_ORIGIN="http://localhost:3000"

# Belge dosyalarının saklandığı klasör (git dışında tutulur)
STORAGE_DIR=./storage
# false: işleri ayrı worker (npm run worker) çalıştırır; varsayılan: istek sonrasında aynı süreçte
INLINE_JOBS=true
